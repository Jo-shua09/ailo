{
  "info": {
    "_postman_id": "c1f7a40b-72df-4db2-8bc2-a1b0a1100001",
    "name": "Ailo API Engine",
    "description": "Ailo API on main. Run in order: 2 (owner session), 3 (register agent), 4 (top up), then payments.\n\nAuth: owner routes need `Authorization: Owner {{owner_token}}` (saved by 'Create Owner Session'). Agent routes need `Authorization: Agent <token>`: an Ed25519 per-request token bound to method, path and exact body, valid 60 s, one use. Postman cannot sign Ed25519, so generate it with the agent kit (see 'Submit Payment').",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://ailo-dx6f.onrender.com",
      "type": "string"
    },
    {
      "key": "ownerPin",
      "value": "",
      "type": "string",
      "description": "Your OWNER_PIN from apps/api/.env (6+ characters). Never commit a real value."
    },
    {
      "key": "owner_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "agent_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "agent_public_x",
      "value": "",
      "type": "string",
      "description": "The 'x' of the public JWK printed by: cd apps/agent && uv run python -m ailo_agent.keys"
    },
    {
      "key": "agent_token",
      "value": "",
      "type": "string",
      "description": "Paste the full 'Agent ...' header value from ailo_agent.signing"
    },
    {
      "key": "payment_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "approval_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "kora_secret_key",
      "value": "",
      "type": "string",
      "description": "Same as KORA_SECRET_KEY in apps/api/.env, used only to sign simulated webhooks locally."
    }
  ],
  "item": [
    {
      "name": "1. Health & Discovery",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "health"
              ]
            }
          }
        },
        {
          "name": "JWKS (active agents' public keys)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/.well-known/jwks.json",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                ".well-known",
                "jwks.json"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Owner Auth",
      "item": [
        {
          "name": "Create Owner Session",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) pm.collectionVariables.set('owner_token', pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pin\": \"{{ownerPin}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/owner/session",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "owner",
                "session"
              ]
            },
            "description": "Swaps OWNER_PIN for a 12 h owner token (saved to owner_token). 5 wrong PINs from one IP lock that IP out for 15 minutes."
          }
        }
      ]
    },
    {
      "name": "3. Agents (Badge + Brake)",
      "item": [
        {
          "name": "Register Agent",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) pm.collectionVariables.set('agent_id', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Owner {{owner_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Shop agent\",\n  \"public_jwk\": { \"kty\": \"OKP\", \"crv\": \"Ed25519\", \"x\": \"{{agent_public_x}}\" }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/agents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "agents"
              ]
            },
            "description": "The agent makes its own keypair (`cd apps/agent && uv run python -m ailo_agent.keys`) and only the PUBLIC key is registered. The server never sees a private key; a JWK containing `d` is rejected."
          }
        },
        {
          "name": "List Agents",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Owner {{owner_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/agents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "agents"
              ]
            }
          }
        },
        {
          "name": "Agent: who am I (signed)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "{{agent_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/agents/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "agents",
                "me"
              ]
            },
            "description": "Generate the token: cd apps/agent && uv run python -m ailo_agent.signing {{agent_id}} GET /v1/agents/me"
          }
        },
        {
          "name": "Pull Brake (kill switch)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Owner {{owner_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/agents/{{agent_id}}/brake",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "agents",
                "{{agent_id}}",
                "brake"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "4. Ledger",
      "item": [
        {
          "name": "Top Up Owner Wallet (mirror ledger)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Owner {{owner_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount_kobo\": 5000000,\n  \"description\": \"Demo top-up (50,000 NGN, sandbox)\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/ledger/topup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "ledger",
                "topup"
              ]
            }
          }
        },
        {
          "name": "Get Balances",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Owner {{owner_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/ledger/balances",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "ledger",
                "balances"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "4b. Spec Gate (spending rules)",
      "description": "Save a rule BEFORE the agent pays: with no saved rule every payment is blocked. Payments follow the latest saved version.",
      "item": [
        {
          "name": "Compile Rule (English -> policy, AI)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Owner {{owner_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/mandates/compile",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "mandates",
                "compile"
              ]
            },
            "description": "Real AI call (LLM_MODEL_SMART). Returns a proposed policy only; nothing is saved. Payee ids: payee_mama_ngozi, payee_lagos_logistics. 503 if no AI model is configured.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"english\": \"Groceries from Mama Ngozi only. Up to N20,000 a payment and N50,000 a week. Ask me above N10,000.\"\n}"
            }
          }
        },
        {
          "name": "Test Rule against recent payments",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Owner {{owner_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/mandates/test",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "mandates",
                "test"
              ]
            },
            "description": "Replays recent payments against a draft policy. Nothing is saved or enforced.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"policy\": {\n    \"allowed_categories\": [\n      \"groceries\"\n    ],\n    \"allowed_payees\": [\n      \"payee_mama_ngozi\"\n    ],\n    \"spending_limits\": [\n      {\n        \"amount_kobo\": 2000000,\n        \"interval\": \"per_payment\"\n      },\n      {\n        \"amount_kobo\": 5000000,\n        \"interval\": \"weekly\"\n      }\n    ],\n    \"nod_above_kobo\": 1000000,\n    \"nod_rolling_payee_24h_kobo\": 1000000,\n    \"expires_at\": \"2030-01-01T00:00:00.000Z\"\n  },\n  \"limit\": 20\n}"
            }
          }
        },
        {
          "name": "Save Rule (becomes active)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Owner {{owner_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/mandates",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "mandates"
              ]
            },
            "description": "Saves a new version; no AI call. Amounts are kobo: 2000000 = N20,000. Enforced today: categories, per-payment and weekly limits, payee list and the Nod threshold.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"english\": \"Groceries from Mama Ngozi only. Up to N20,000 a payment and N50,000 a week. Ask me above N10,000.\",\n  \"policy\": {\n    \"allowed_categories\": [\n      \"groceries\"\n    ],\n    \"allowed_payees\": [\n      \"payee_mama_ngozi\"\n    ],\n    \"spending_limits\": [\n      {\n        \"amount_kobo\": 2000000,\n        \"interval\": \"per_payment\"\n      },\n      {\n        \"amount_kobo\": 5000000,\n        \"interval\": \"weekly\"\n      }\n    ],\n    \"nod_above_kobo\": 1000000,\n    \"nod_rolling_payee_24h_kobo\": 1000000,\n    \"expires_at\": \"2030-01-01T00:00:00.000Z\"\n  }\n}"
            }
          }
        },
        {
          "name": "List Rules (all versions)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Owner {{owner_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/mandates",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "mandates"
              ]
            },
            "description": "Newest first."
          }
        },
        {
          "name": "Agent: current rule (signed)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Agent {{agent_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/mandates/current",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "mandates",
                "current"
              ]
            },
            "description": "What the buyer agent reads first. Fresh agent token: `uv run python -m ailo_agent.signing {{agent_id}} GET /v1/mandates/current`. 404 NO_MANDATE until a rule is saved."
          }
        }
      ]
    },
    {
      "name": "5. Payments",
      "item": [
        {
          "name": "Submit Payment (agent-signed)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var j = pm.response.json(); if (j.payment) pm.collectionVariables.set('payment_id', j.payment.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "{{agent_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"payee_id\":\"payee_mama_ngozi\",\"amount_kobo\":850000,\"category\":\"groceries\",\"reason\":\"Restock rice for the shop\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/payments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "payments"
              ]
            },
            "description": "The signature covers the exact body bytes. 1) Save this body (one line, no changes) to apps/agent/body.json. 2) cd apps/agent && uv run python -m ailo_agent.signing {{agent_id}} POST /v1/payments body.json 3) Paste the printed 'Agent ...' into agent_token and send within 60 s. Each token works once. Bank details come from the server's payee directory (payee_mama_ngozi, payee_lagos_logistics), never from this body. Optional field: page_text (max 20,000 chars), the shop page the agent acted on, so Second Look can spot a poisoned page. Kora pays out only between N1,000 and N10,000,000, so amount_kobo must be at least 100000.\n\nA clean payment ends `submitted`: Kora accepted the payout. It becomes `settled` when Kora's webhook arrives (set the webhook URL in the Kora dashboard to {PUBLIC_BASE_URL}/v1/webhooks/kora; Kora's payout API does not take a notification_url) or when you run Square Up."
          }
        },
        {
          "name": "List Payments",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Owner {{owner_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/payments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "payments"
              ]
            }
          }
        },
        {
          "name": "Get Payment + Receipt",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Owner {{owner_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/payments/{{payment_id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "payments",
                "{{payment_id}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "6. Approvals (Nod)",
      "item": [
        {
          "name": "List Pending Approvals",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var a = pm.response.json().approvals || []; if (a.length) pm.collectionVariables.set('approval_id', a[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Owner {{owner_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/approvals",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "approvals"
              ]
            }
          }
        },
        {
          "name": "Get Approval",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Owner {{owner_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/approvals/{{approval_id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "approvals",
                "{{approval_id}}"
              ]
            }
          }
        },
        {
          "name": "Approve",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Owner {{owner_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"approve\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/approvals/{{approval_id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "approvals",
                "{{approval_id}}"
              ]
            }
          }
        },
        {
          "name": "Deny",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Owner {{owner_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"deny\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/approvals/{{approval_id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "approvals",
                "{{approval_id}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "7. Kora Webhooks (simulated locally)",
      "item": [
        {
          "name": "Webhook - transfer.success",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Kora signs HMAC-SHA256 of JSON.stringify(body.data) with the secret key (Kora webhook docs), not the whole body.",
                  "var data = JSON.parse(pm.request.body.raw).data;",
                  "var sig = CryptoJS.HmacSHA256(JSON.stringify(data), pm.collectionVariables.get('kora_secret_key')).toString(CryptoJS.enc.Hex);",
                  "pm.request.headers.upsert({ key: 'x-korapay-signature', value: sig });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"transfer.success\",\n  \"data\": { \"reference\": \"AL-{{payment_id}}\", \"status\": \"success\", \"amount\": \"8500.00\", \"fee\": 10, \"currency\": \"NGN\" }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/webhooks/kora",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "webhooks",
                "kora"
              ]
            },
            "description": "Real Kora webhooks need a public URL (ngrok). The server treats a webhook as a hint and re-checks the payout with Kora (GET /transactions/:reference)."
          }
        },
        {
          "name": "Webhook - transfer.failed",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var data = JSON.parse(pm.request.body.raw).data;",
                  "var sig = CryptoJS.HmacSHA256(JSON.stringify(data), pm.collectionVariables.get('kora_secret_key')).toString(CryptoJS.enc.Hex);",
                  "pm.request.headers.upsert({ key: 'x-korapay-signature', value: sig });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"transfer.failed\",\n  \"data\": { \"reference\": \"AL-{{payment_id}}\", \"status\": \"failed\", \"amount\": \"8500.00\", \"fee\": 0, \"currency\": \"NGN\" }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/webhooks/kora",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "webhooks",
                "kora"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "8. Ops & Live Events",
      "item": [
        {
          "name": "Square Up (reconcile with Kora)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Owner {{owner_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/ops/reconcile",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "ops",
                "reconcile"
              ]
            },
            "description": "\n\nUse this after a payout to pull the final status from Kora (GET /transactions/:reference) when no webhook has arrived."
          }
        },
        {
          "name": "Live Events (SSE)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "text/event-stream"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/events?access_token={{owner_token}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "events"
              ],
              "query": [
                {
                  "key": "access_token",
                  "value": "{{owner_token}}"
                }
              ]
            },
            "description": "Browsers cannot send headers on EventSource, so the owner token goes in ?access_token= (RFC 6750 section 2.3)."
          }
        }
      ]
    }
  ]
}
