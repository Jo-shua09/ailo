# Ailo API Engine Environment Variables
NODE_ENV=development
PORT=4000
PUBLIC_BASE_URL=http://localhost:4000
CONSOLE_ORIGIN=http://localhost:3000

# Persistence (MongoDB)
MONGODB_URI=mongodb://localhost:27017/ailo

# Payout Rail (Kora)
KORA_MODE=test
KORA_BASE_URL=https://api.korapay.com/merchant/api/v1
KORA_SECRET_KEY=test_kora_secret_key
KORA_WEBHOOK_PATH=/v1/webhooks/kora

# Owner Auth & Session Secret (min 6 chars for PIN, min 16 chars for SESSION_SECRET)
OWNER_PIN=123456
SESSION_SECRET=ailo_super_secret_session_key_123456

# AI / LLM Configuration
LLM_PROVIDER=google
LLM_MODEL_FAST=gemini-3.5-flash-lite
LLM_MODEL_SMART=gemini-3.8-flash
LLM_TIMEOUT_MS=1800
GEMINI_API_KEY=
