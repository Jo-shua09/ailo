# Ailo API (apps/api). Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=4000
# Public HTTPS URL of this API (ngrok static domain locally, or the deployed URL).
PUBLIC_BASE_URL=https://your-domain.ngrok-free.app

# Database (MongoDB connection string)
MONGODB_URI=mongodb://localhost:27017/ailo
# Legacy / alternative DATABASE_URL
DATABASE_URL=mongodb://localhost:27017/ailo

# Kora (test mode). Dashboard: Test mode on, then Settings > API Configuration.
# Do NOT click "Generate New API Keys": it revokes the current keys.
KORA_MODE=test
KORA_BASE_URL=https://api.korapay.com/merchant/api/v1
KORA_SECRET_KEY=
KORA_PUBLIC_KEY=
# Only needed for card charges; Ailo payouts don't use it.
KORA_ENCRYPTION_KEY=
KORA_WEBHOOK_PATH=/v1/webhooks/kora

# AI provider (Vercel AI SDK): google | openai | anthropic. Only the selected provider's key is required.
LLM_PROVIDER=google
# FAST = Second Look (hard deadline), SMART = Spec Gate rule compiling.
# OpenAI: gpt-6-luna / Anthropic: claude-haiku-5-5 (fast). Measure latency before the demo.
LLM_MODEL_FAST=gemini-3.5-flash-lite
LLM_MODEL_SMART=gemini-3.8-flash
# The AI SDK reads the Gemini key as GOOGLE_GENERATIVE_AI_API_KEY; config/env.ts maps GEMINI_API_KEY to it.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Second Look hard deadline (call it with maxRetries: 0). On timeout the payment escalates to the owner's Nod.
LLM_TIMEOUT_MS=1800

# Owner console session
OWNER_PIN=
SESSION_SECRET=

# Console origin allowed by CORS
CONSOLE_ORIGIN=http://localhost:3000
