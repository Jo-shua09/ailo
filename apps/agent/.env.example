# Ailo buyer agent + eval (apps/agent, Python). Copy to .env and fill in. Never commit .env.

AILO_API_URL=http://localhost:4000
SHOP_URL=http://localhost:3001
AGENT_ID=
# Path to the agent's Ed25519 private key (issued when the agent is added in the console).
AGENT_PRIVATE_KEY_PATH=./keys/agent.pem

# Pydantic AI model string: provider:model, e.g. google:gemini-3.8-flash | openai:gpt-6-luna | anthropic:claude-haiku-5-5
LLM_MODEL=google:gemini-3.8-flash
# Pydantic AI reads the Gemini key as GOOGLE_API_KEY; the agent maps GEMINI_API_KEY to it.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
